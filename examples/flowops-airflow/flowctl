          exit 2
        fi
        date="$2"
        shift 2
        ;;
      *)
        echo "flowctl dataset backfill: unknown argument: $1" >&2
        exit 2
        ;;
    esac
  done
  if [[ "${dag_id}" != "orders_reconcile_2026" || "${date}" != "2026-05-06" ]]; then
    echo "FlowOpsFreshnessError: no test dataset backfill matches ${dag_id} ${date}" >&2
    exit 1
  fi
  mark_scenario "orders_reconcile_2026"
  echo "FlowOps dataset backfill marked ready: ${dag_id} ds=${date}"
  echo "Next: flowctl check ${dag_id}"
}

