#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${SOURCE}" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
  SOURCE="$(readlink "${SOURCE}")"
  [[ "${SOURCE}" != /* ]] && SOURCE="${SOURCE_DIR}/${SOURCE}"
done

SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
DEMO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
REPO_ROOT="$(cd "${DEMO_DIR}/../.." && pwd)"
WORKSPACE_DIR="${FLOWOPS_DEMO_WORKSPACE:-${DEMO_DIR}/.demo-workspace}"
RESET=1
INIT=1
NO_OPENCLAW=0

usage() {
  cat <<'USAGE'
Usage:
  examples/flowops-airflow/scripts/run-demo [--no-reset] [--skip-init] [--no-openclaw]

Runs the lark-cue FlowOps demo inside the disposable demo workspace.
By default it resets the workspace to the broken fixture, initializes Airflow,
then runs: lark-cue run -- ./flowctl check billing_daily
USAGE
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --no-reset)
      RESET=0
      shift
      ;;
    --skip-init)
      INIT=0
      shift
      ;;
    --no-openclaw)
      NO_OPENCLAW=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "run-demo: unknown flag: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ "${RESET}" -eq 1 || ! -x "${WORKSPACE_DIR}/flowctl" ]]; then
  "${SCRIPT_DIR}/reset-demo" --quiet --workspace "${WORKSPACE_DIR}"
fi

if command -v lark-cue >/dev/null 2>&1; then
  LARK_CUE=(lark-cue)
elif [[ -x "${REPO_ROOT}/bin/lark-cue" ]]; then
  LARK_CUE=("${REPO_ROOT}/bin/lark-cue")
else
  mkdir -p "${WORKSPACE_DIR}/.bin"
  go build -o "${WORKSPACE_DIR}/.bin/lark-cue" "${REPO_ROOT}/cmd/lark-cue"
  LARK_CUE=("${WORKSPACE_DIR}/.bin/lark-cue")
fi

cd "${WORKSPACE_DIR}"

if [[ "${INIT}" -eq 1 ]]; then
  ./flowctl init
fi

ARGS=(run)
if [[ "${NO_OPENCLAW}" -eq 1 ]]; then
  ARGS+=(--no-openclaw)
fi
ARGS+=(-- ./flowctl check billing_daily)

"${LARK_CUE[@]}" "${ARGS[@]}"
