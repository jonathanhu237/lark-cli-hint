#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SOURCE="${ROOT_DIR}/flowctl"
BIN_DIR="${GOBIN:-}"
FORCE=0

usage() {
  cat <<'USAGE'
Usage:
  examples/flowops-airflow/scripts/install-flowctl [--bin-dir <dir>] [--force]

Ensures the FlowOps demo CLI is available as `flowctl`.
If `flowctl` is already in PATH, the script does nothing unless --force is set.
When installing, it links the demo CLI into a bin directory.
Defaults to $GOBIN, or $(go env GOPATH)/bin when $GOBIN is empty.
USAGE
}

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --bin-dir)
      if [[ "$#" -lt 2 ]]; then
        echo "install-flowctl: --bin-dir requires a directory" >&2
        exit 2
      fi
      BIN_DIR="$2"
      shift 2
      ;;
    --force)
      FORCE=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "install-flowctl: unknown flag: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ ! -x "${SOURCE}" ]]; then
  echo "install-flowctl: source flowctl is not executable: ${SOURCE}" >&2
  exit 1
fi

if [[ "${FORCE}" -ne 1 ]]; then
  EXISTING="$(command -v flowctl || true)"
  if [[ -n "${EXISTING}" ]]; then
    echo "flowctl already installed: ${EXISTING}"
    exit 0
  fi
fi

if [[ -z "${BIN_DIR}" ]]; then
  if ! command -v go >/dev/null 2>&1; then
    echo "install-flowctl: Go is required to resolve GOPATH, or pass --bin-dir" >&2
    exit 127
  fi
  BIN_DIR="$(go env GOPATH)/bin"
fi

mkdir -p "${BIN_DIR}"
TARGET="${BIN_DIR}/flowctl"

if [[ -e "${TARGET}" || -L "${TARGET}" ]]; then
  CURRENT=""
  if [[ -L "${TARGET}" ]]; then
    CURRENT="$(readlink "${TARGET}")"
  fi
  if [[ "${CURRENT}" != "${SOURCE}" && "${FORCE}" -ne 1 ]]; then
    echo "install-flowctl: ${TARGET} already exists; pass --force to replace it" >&2
    exit 1
  fi
fi

ln -sfn "${SOURCE}" "${TARGET}"

echo "Installed flowctl -> ${SOURCE}"
echo "Target: ${TARGET}"
case ":${PATH}:" in
  *":${BIN_DIR}:"*) ;;
  *) echo "Add to PATH: export PATH=\"${BIN_DIR}:\$PATH\"" ;;
esac
