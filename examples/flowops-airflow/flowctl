override_feature() {
  local dag_id="${1:-}"
  shift || true
  local flag=""
  local cohort=""
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --flag)
        if [[ "$#" -lt 2 ]]; then
          echo "flowctl feature override: --flag requires an id" >&2
          exit 2
        fi
        flag="$2"
        shift 2
        ;;
      --cohort)
        if [[ "$#" -lt 2 ]]; then
          echo "flowctl feature override: --cohort requires a name" >&2
          exit 2
        fi
        cohort="$2"
        shift 2
        ;;
      *)
        echo "flowctl feature override: unknown argument: $1" >&2
        exit 2
        ;;
    esac
  done
  if [[ "${dag_id}" != "churn_features" || "${flag}" != "EXP-883" || "${cohort}" != "cohort_v3" ]]; then
    echo "FlowOpsExperimentGateError: no test feature override matches ${dag_id} ${flag} ${cohort}" >&2
    exit 1
  fi
  mark_scenario "churn_features_gate"
  echo "FlowOps feature override applied: ${dag_id} flag=${flag} cohort=${cohort}"
  echo "Next: flowctl check ${dag_id}"
}

reset_feature() {
  local dag_id="${1:-}"
  case "${dag_id}" in
    ""|"churn_features")
      reset_marker "churn_features_gate"
      echo "FlowOps feature state reset: ${dag_id:-all}"
      ;;
    *)
      echo "flowctl feature reset: unknown demo dag ${dag_id}" >&2
      exit 2
      ;;
  esac
}

