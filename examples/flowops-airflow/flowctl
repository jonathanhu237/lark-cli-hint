refresh_source() {
  local dag_id="${1:-}"
  shift || true
  local alias=""
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --alias)
        if [[ "$#" -lt 2 ]]; then
          echo "flowctl source refresh: --alias requires <missing=actual>" >&2
          exit 2
        fi
        alias="$2"
        shift 2
        ;;
      *)
        echo "flowctl source refresh: unknown argument: $1" >&2
        exit 2
        ;;
    esac
  done
  if [[ -z "${dag_id}" || -z "${alias}" ]]; then
    echo "Usage: flowctl source refresh <dag_id> --alias <missing=actual>" >&2
    exit 2
  fi
  if [[ "${dag_id}" != "billing_export_2026" || "${alias}" != "customer_segment=segment" ]]; then
    echo "FlowOpsSourceError: no test source binding matches ${dag_id} ${alias}" >&2
    exit 1
  fi
  mkdir -p "${ROOT_DIR}/.flowops"
  local state_file
  state_file="$(source_state_file)"
  if ! source_alias_present "${dag_id}" "${alias}"; then
    echo "${dag_id} ${alias}" >> "${state_file}"
  fi
  echo "FlowOps source refreshed: ${dag_id} ${alias}"
  echo "Next: flowctl check ${dag_id}"
}

reset_source() {
  local dag_id="${1:-}"
  local state_file
  state_file="$(source_state_file)"
  if [[ -z "${dag_id}" ]]; then
    rm -f "${state_file}"
    echo "FlowOps source bindings reset"
    return
  fi
  if [[ -f "${state_file}" ]]; then
    local tmp_file="${state_file}.tmp"
    grep -Fv "${dag_id} " "${state_file}" > "${tmp_file}" || true
    mv "${tmp_file}" "${state_file}"
  fi
  echo "FlowOps source binding reset: ${dag_id}"
}

case "${command}" in
  init)
    run_airflow "db migrate"
    run_airflow "users create --username admin --firstname FlowOps --lastname Demo --role Admin --email flowops-demo@example.com --password admin || true"
    ;;
  check)
    dag_id="${2:-billing_daily}"
    case "${dag_id}" in
      billing_export_2026)
        check_billing_export
        ;;
      orders_reconcile_2026)
        check_orders_reconcile
        ;;
      ad_spend_daily)
        check_ad_spend_daily
        ;;
      inventory_snapshot)
        check_inventory_snapshot
        ;;
      churn_features)
        check_churn_features
        ;;
      payment_settlement)
        check_payment_settlement
        ;;
      crm_sync)
        check_crm_sync
        ;;
      customer360_pii)
        check_customer360_pii
        ;;
      *)
        run_airflow "dags list-import-errors"
        run_airflow "dags show ${dag_id}"
        ;;
    esac
    ;;
  capacity)
    subcommand="${2:-}"
    case "${subcommand}" in
      bump)
        shift 2
        bump_capacity "$@"
        ;;
      reset)
        shift 2
        reset_capacity "$@"
        ;;
      *)
        echo "Usage: flowctl capacity bump <dag_id> --pool <name> --slots <n>" >&2
        echo "       flowctl capacity reset [dag_id]" >&2
        exit 2
        ;;
    esac
    ;;
  dataset)
    subcommand="${2:-}"
    case "${subcommand}" in
      backfill)
        shift 2
        backfill_dataset "$@"
        ;;
      reset)
        shift 2
        reset_dataset "$@"
        ;;
      *)
        echo "Usage: flowctl dataset backfill <dag_id> --date <yyyy-mm-dd>" >&2
        echo "       flowctl dataset reset [dag_id]" >&2
        exit 2
        ;;
    esac
    ;;
  feature)
    subcommand="${2:-}"
    case "${subcommand}" in
      override)
        shift 2
        override_feature "$@"
        ;;
      reset)
        shift 2
        reset_feature "$@"
        ;;
      *)
        echo "Usage: flowctl feature override <dag_id> --flag <id> --cohort <name>" >&2
        echo "       flowctl feature reset [dag_id]" >&2
        exit 2
        ;;
    esac
    ;;
  governance)
    subcommand="${2:-}"
    case "${subcommand}" in
      approve)
        shift 2
        approve_governance "$@"
        ;;
      reset)
        shift 2
        reset_governance "$@"
        ;;
      *)
        echo "Usage: flowctl governance approve <dag_id> --policy <id> --ticket <id>" >&2
        echo "       flowctl governance reset [dag_id]" >&2
        exit 2
        ;;
    esac
    ;;
  network)
    subcommand="${2:-}"
    case "${subcommand}" in
      allow)
        shift 2
        allow_network "$@"
        ;;
      reset)
        shift 2
        reset_network "$@"
        ;;
      *)
        echo "Usage: flowctl network allow <dag_id> --service <host> --profile <name>" >&2
        echo "       flowctl network reset [dag_id]" >&2
        exit 2
        ;;
    esac
    ;;
  quota)
    subcommand="${2:-}"
    case "${subcommand}" in
      claim)
        shift 2
        claim_quota "$@"
        ;;
      reset)
        shift 2
        reset_quota "$@"
        ;;
      *)
        echo "Usage: flowctl quota claim <dag_id> --bucket <name> --mode <mode>" >&2
        echo "       flowctl quota reset [dag_id]" >&2
        exit 2
        ;;
    esac
    ;;
  secrets)
    subcommand="${2:-}"
    case "${subcommand}" in
      renew)
        shift 2
        renew_secret "$@"
        ;;
      reset)
        shift 2
        reset_secret "$@"
        ;;
      *)
        echo "Usage: flowctl secrets renew <dag_id> --secret <name> --epoch <epoch>" >&2
        echo "       flowctl secrets reset [dag_id]" >&2
        exit 2
        ;;
    esac
    ;;
  source)
    subcommand="${2:-}"
    case "${subcommand}" in
      refresh)
        shift 2
        refresh_source "$@"
        ;;
      reset)
        shift 2
        reset_source "$@"
        ;;
      *)
        echo "Usage: flowctl source refresh <dag_id> --alias <missing=actual>" >&2
        echo "       flowctl source reset [dag_id]" >&2
        exit 2
        ;;
    esac
    ;;
  airflow)
    shift
    if [[ "$#" -eq 0 ]]; then
      usage >&2
      exit 2
    fi
    run_airflow "$*"
    ;;
  up)
    ensure_compose
    "${COMPOSE[@]}" -f "${COMPOSE_FILE}" up -d airflow-webserver airflow-scheduler
    ;;
  down)
    ensure_compose
    "${COMPOSE[@]}" -f "${COMPOSE_FILE}" down
    ;;
  clean)
    ensure_compose
    "${COMPOSE[@]}" -f "${COMPOSE_FILE}" down --remove-orphans
    rm -f "${ROOT_DIR}/airflow.db" "${ROOT_DIR}/airflow.db-shm" "${ROOT_DIR}/airflow.db-wal" "${ROOT_DIR}/airflow.cfg"
    rm -rf "${ROOT_DIR}/logs" "${ROOT_DIR}/plugins/__pycache__" "${ROOT_DIR}/tmp" "${ROOT_DIR}/.tmp" "${ROOT_DIR}/.flowops"
    ;;
  *)
    echo "flowctl: unknown command: ${command}" >&2
    usage >&2
    exit 2
    ;;
esac
